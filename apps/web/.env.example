# Public URL of the Klix API (Phoenix)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: URL the Next.js server uses to reach the API (e.g. inside Docker)
API_INTERNAL_URL=
# Public URL of this site, used for metadata and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Google sign-in through Firebase (same project as the API's FIREBASE_PROJECT_ID)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
